# Copy this file to ".env" and fill in real values.
# NEVER commit your actual ".env" file (with real secrets) to version control.

# --- Database ---
DATABASE_URL=sqlite:///./health_assistant.db

# --- JWT Authentication ---
# Use a long, random string in production (e.g. generate with: openssl rand -hex 32)
SECRET_KEY=replace-this-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI Service (OpenAI-compatible API) ---
# Leave AI_API_KEY empty to run the project in "demo mode" with safe
# fallback responses (no external API calls, no cost).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
